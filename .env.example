# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cron endpoints (/api/cron/whales, /api/cron/scan) refuse to run without this.
# cron-job.org: append ?key=<secret>   Vercel Cron: sends Authorization: Bearer <secret>
CRON_SECRET=

# LLM (first working provider wins; see lib/intelligence/llm.ts). At least one is required for news + pure-AI signals.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# LLM_PROVIDER=openai|gemini|openrouter   (optional: pin one)

# Optional context sources
ALPHA_VANTAGE_API_KEY=
FRED_API_KEY=
ALETHEIA_API_KEY=
LEGISCAN_API_KEY=
